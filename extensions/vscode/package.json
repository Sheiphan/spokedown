{
  "name": "spokedown",
  "displayName": "Spokedown: Markdown Read Aloud, Word by Word",
  "description": "Read Markdown aloud with a natural local voice that highlights every word. Understands math, tables, code and diagrams. Built for technical and coding-agent docs. macOS, Windows and Linux.",
  "version": "0.4.0",
  "publisher": "SheiphanJoseph",
  "private": true,
  "license": "GPL-3.0-only",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other",
    "Education"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "contributes": {
    "commands": [
      {
        "command": "spokedown.toggle",
        "title": "Play / Pause",
        "category": "Spokedown",
        "icon": "$(play)"
      },
      {
        "command": "spokedown.readFromCursor",
        "title": "Read from Cursor",
        "category": "Spokedown",
        "icon": "$(play)"
      },
      {
        "command": "spokedown.readFile",
        "title": "Read File from Start",
        "category": "Spokedown"
      },
      {
        "command": "spokedown.readSelection",
        "title": "Read Selection",
        "category": "Spokedown"
      },
      {
        "command": "spokedown.pause",
        "title": "Pause",
        "category": "Spokedown"
      },
      {
        "command": "spokedown.resume",
        "title": "Resume",
        "category": "Spokedown"
      },
      {
        "command": "spokedown.stop",
        "title": "Stop",
        "category": "Spokedown",
        "icon": "$(debug-stop)"
      },
      {
        "command": "spokedown.nextSentence",
        "title": "Next Sentence",
        "category": "Spokedown"
      },
      {
        "command": "spokedown.previousSentence",
        "title": "Previous Sentence",
        "category": "Spokedown"
      },
      {
        "command": "spokedown.nextHeading",
        "title": "Next Heading",
        "category": "Spokedown"
      },
      {
        "command": "spokedown.previousHeading",
        "title": "Previous Heading",
        "category": "Spokedown"
      },
      {
        "command": "spokedown.skipBlock",
        "title": "Skip Block (table, code, list)",
        "category": "Spokedown"
      },
      {
        "command": "spokedown.faster",
        "title": "Faster",
        "category": "Spokedown"
      },
      {
        "command": "spokedown.slower",
        "title": "Slower",
        "category": "Spokedown"
      },
      {
        "command": "spokedown.setSpeed",
        "title": "Set Speed…",
        "category": "Spokedown"
      },
      {
        "command": "spokedown.selectVoice",
        "title": "Select Voice…",
        "category": "Spokedown"
      },
      {
        "command": "spokedown.addPronunciation",
        "title": "Fix Pronunciation…",
        "category": "Spokedown"
      },
      {
        "command": "spokedown.editPronunciations",
        "title": "Edit Pronunciation Dictionary",
        "category": "Spokedown"
      },
      {
        "command": "spokedown.selectModel",
        "title": "Select Model…",
        "category": "Spokedown"
      },
      {
        "command": "spokedown.followReading",
        "title": "Back to Reading Position",
        "category": "Spokedown"
      },
      {
        "command": "spokedown.showScript",
        "title": "Show Spoken Script",
        "category": "Spokedown"
      },
      {
        "command": "spokedown.clearCache",
        "title": "Clear Audio Cache",
        "category": "Spokedown"
      },
      {
        "command": "spokedown.openPreview",
        "title": "Open Read-Along Preview",
        "category": "Spokedown",
        "icon": "$(book)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "spokedown.openPreview",
          "when": "editorLangId == markdown",
          "group": "navigation@89"
        },
        {
          "command": "spokedown.readFromCursor",
          "when": "editorLangId == markdown && !spokedown.active",
          "group": "navigation@90"
        },
        {
          "command": "spokedown.stop",
          "when": "editorLangId == markdown && spokedown.active",
          "group": "navigation@90"
        }
      ],
      "editor/context": [
        {
          "command": "spokedown.readFromCursor",
          "when": "editorLangId == markdown",
          "group": "spokedown@1"
        },
        {
          "command": "spokedown.readSelection",
          "when": "editorLangId == markdown && editorHasSelection",
          "group": "spokedown@2"
        },
        {
          "command": "spokedown.addPronunciation",
          "when": "editorLangId == markdown",
          "group": "spokedown@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "spokedown.toggle",
        "key": "ctrl+alt+r",
        "when": "editorLangId == markdown || spokedown.active || activeWebviewPanelId == 'spokedown.preview'"
      },
      {
        "command": "spokedown.stop",
        "key": "ctrl+alt+s",
        "when": "spokedown.active"
      },
      {
        "command": "spokedown.nextSentence",
        "key": "ctrl+alt+right",
        "when": "spokedown.active"
      },
      {
        "command": "spokedown.previousSentence",
        "key": "ctrl+alt+left",
        "when": "spokedown.active"
      },
      {
        "command": "spokedown.nextHeading",
        "key": "ctrl+alt+down",
        "when": "spokedown.active"
      },
      {
        "command": "spokedown.previousHeading",
        "key": "ctrl+alt+up",
        "when": "spokedown.active"
      },
      {
        "command": "spokedown.skipBlock",
        "key": "ctrl+alt+j",
        "when": "spokedown.active"
      },
      {
        "command": "spokedown.faster",
        "key": "ctrl+alt+=",
        "when": "spokedown.active"
      },
      {
        "command": "spokedown.slower",
        "key": "ctrl+alt+-",
        "when": "spokedown.active"
      }
    ],
    "colors": [
      {
        "id": "spokedown.wordHighlightBackground",
        "description": "Background of the word being spoken.",
        "defaults": {
          "dark": "#e6b42266",
          "light": "#f5c40066",
          "highContrast": "#e6b42299"
        }
      },
      {
        "id": "spokedown.sentenceHighlightBackground",
        "description": "Background of the sentence being spoken.",
        "defaults": {
          "dark": "#4fa3ff1c",
          "light": "#3478f61a",
          "highContrast": "#4fa3ff33"
        }
      },
      {
        "id": "spokedown.blockHighlightBackground",
        "description": "Whole-line background of the block (table, code, diagram, equation) being described.",
        "defaults": {
          "dark": "#ffffff0b",
          "light": "#0000000a",
          "highContrast": "#ffffff1a"
        }
      }
    ],
    "configuration": {
      "title": "Spokedown",
      "properties": {
        "spokedown.model": {
          "type": "string",
          "default": "kokoro",
          "markdownDescription": "Model to read with: `kokoro` (natural, exact word highlighting), `kokoro-compact` (smaller download), `system` (macOS voices, macOS only), or the `id` of an entry in `#spokedown.models#`."
        },
        "spokedown.voice": {
          "type": "string",
          "default": "",
          "markdownDescription": "Voice id (e.g. `af_heart`, `bf_emma`, `am_michael`). Empty = the model's default. Use **Spokedown: Select Voice…**."
        },
        "spokedown.speed": {
          "type": "number",
          "default": 1,
          "minimum": 0.5,
          "maximum": 2,
          "description": "Speaking rate (0.5–2). Changes apply from the next sentence."
        },
        "spokedown.models": {
          "type": "array",
          "default": [],
          "markdownDescription": "Extra models. Examples:\n\n```json\n{ \"id\": \"mlx\", \"type\": \"openai\", \"baseUrl\": \"http://localhost:8000\", \"model\": \"mlx-community/Kokoro-82M-bf16\" }\n{ \"id\": \"kokoro-fp16\", \"type\": \"kokoro-onnx\", \"modelId\": \"onnx-community/Kokoro-82M-v1.0-ONNX-timestamped\", \"dtype\": \"fp16\" }\n```",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "kokoro-onnx",
                  "openai",
                  "say"
                ]
              },
              "label": {
                "type": "string"
              },
              "modelId": {
                "type": "string"
              },
              "dtype": {
                "type": "string",
                "enum": [
                  "fp32",
                  "fp16",
                  "q8",
                  "q4",
                  "q4f16"
                ]
              },
              "baseUrl": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "apiKey": {
                "type": "string"
              },
              "voices": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "defaultVoice": {
                "type": "string"
              }
            }
          }
        },
        "spokedown.dataDirectory": {
          "type": "string",
          "default": "",
          "markdownDescription": "Where models and the audio cache live. Empty = `~/.cache/spokedown` (macOS), `$XDG_CACHE_HOME/spokedown` or `~/.cache/spokedown` (Linux), `%LOCALAPPDATA%\\\\spokedown` (Windows)."
        },
        "spokedown.cacheSizeMB": {
          "type": "number",
          "default": 512,
          "minimum": 16,
          "description": "Maximum size of the on-disk audio cache."
        },
        "spokedown.prefetch": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "description": "Sentences synthesized ahead of playback."
        },
        "spokedown.preloadModel": {
          "type": "boolean",
          "default": true,
          "description": "Load the voice model in the background when a Markdown file is opened, so reading starts immediately (uses ~400 MB of memory for Kokoro)."
        },
        "spokedown.highlight.words": {
          "type": "boolean",
          "default": true,
          "description": "Highlight the word being spoken (sentence and block highlights are always shown)."
        },
        "spokedown.highlight.leadMs": {
          "type": "number",
          "default": 60,
          "description": "Move the word highlight this many ms ahead of the audio so it feels in sync."
        },
        "spokedown.audioOutput": {
          "type": "string",
          "enum": [
            "auto",
            "afplay",
            "silent"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Play through the operating system (afplay on macOS, PowerShell on Windows, paplay/pw-play/aplay and others on Linux).",
            "Same as auto (the old name, kept so existing settings keep working).",
            "Run the reading clock without sound (for testing highlighting)."
          ],
          "markdownDescription": "How audio is played. `auto` uses your OS's own player; `silent` runs the highlighting clock without sound."
        },
        "spokedown.audioLatencyMs": {
          "type": "number",
          "default": 90,
          "description": "Delay between starting playback and hearing sound; highlighting compensates for it. Raise it if highlighting runs ahead of the voice (Linux players with large buffers may need 200–500)."
        },
        "spokedown.autoScroll": {
          "type": "boolean",
          "default": true,
          "description": "Keep the reading position in view. Scrolling away pauses following until you return."
        },
        "spokedown.preview.openOnRead": {
          "type": "boolean",
          "default": false,
          "description": "Open the read-along preview beside the editor whenever reading starts."
        },
        "spokedown.reading.code": {
          "type": "string",
          "enum": [
            "announce",
            "read",
            "skip"
          ],
          "default": "announce",
          "markdownDescription": "Code blocks: `announce` (\"Python code block, 12 lines\"), `read` line by line, or `skip`."
        },
        "spokedown.reading.codeMaxLines": {
          "type": "number",
          "default": 20,
          "description": "When reading code, stop after this many lines."
        },
        "spokedown.reading.tables": {
          "type": "string",
          "enum": [
            "rows",
            "announce",
            "skip"
          ],
          "default": "rows",
          "markdownDescription": "Tables: announce then read each `rows` with column labels, only `announce`, or `skip`."
        },
        "spokedown.reading.mathDisplay": {
          "type": "string",
          "enum": [
            "short",
            "full",
            "announce"
          ],
          "default": "short",
          "markdownDescription": "Display equations: `short` reads them unless long, `full` always reads, `announce` just says \"Equation\"."
        },
        "spokedown.reading.mermaid": {
          "type": "string",
          "enum": [
            "announce",
            "skip"
          ],
          "default": "announce",
          "description": "Mermaid diagrams."
        },
        "spokedown.reading.dataBlocks": {
          "type": "string",
          "enum": [
            "announce",
            "skip"
          ],
          "default": "announce",
          "description": "Unlabelled code fences that only contain numbers (traces, arrays)."
        },
        "spokedown.reading.frontmatter": {
          "type": "string",
          "enum": [
            "skip",
            "announce"
          ],
          "default": "skip",
          "description": "YAML frontmatter (SKILL.md frontmatter is always announced)."
        },
        "spokedown.reading.numberDigits": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 12,
          "description": "Decimals with more significant digits are rounded and read as \"about …\"."
        },
        "spokedown.pause.sentenceMs": {
          "type": "number",
          "default": 150,
          "minimum": 0,
          "maximum": 1500,
          "markdownDescription": "Pause after each sentence, in milliseconds. Set to `0` for the fastest, most continuous reading. (The voice's own built-in silence around every sentence is trimmed, so this value is the whole gap.)"
        },
        "spokedown.pause.blockScale": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 3,
          "markdownDescription": "Multiplier for the longer pauses at the end of paragraphs, headings, list items, tables and code blocks. `1` is the default (about 0.3 s after a paragraph, 0.7 s before a heading); `0.5` halves them; `0` removes them."
        },
        "spokedown.pause.trimSilence": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Cut the silence the voice adds before and after every sentence (about 0.3 s and 0.45 s for Kokoro), so `#spokedown.pause.sentenceMs#` controls the whole gap. Turn off to hear the voice's original timing. Takes effect from the next sentence."
        },
        "spokedown.pronunciations": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "Respell words so the voice says them right. Keys are matched against the Markdown source: plain lowercase keys ignore case (`kubectl` also matches `Kubectl` and `` `kubectl` ``), keys with capitals match exactly (`K8s`), and a key with spaces matches a phrase (`Claude Code`). A key also matches a part of an identifier (`kubectl` in `kubectl_apply`). An empty value silences the word.\n\nExample:\n\n```json\n\"spokedown.pronunciations\": {\n  \"kubectl\": \"kube control\",\n  \"nginx\": \"engine x\",\n  \"K8s\": \"kates\"\n}\n```\n\nTip: put the cursor on a word and run **Spokedown: Fix Pronunciation…**."
        },
        "spokedown.starterPronunciations": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Turn on a built-in starter list of 58 respellings for names common in developer and AI docs (`kubectl`, `nginx`, `sudo`, `yaml`, `mcp`, `llm`, …). They are best-effort; your own `#spokedown.pronunciations#` always override them. To undo a single entry, map it to itself, e.g. `\"json\": \"json\"`. [Full list](https://github.com/Sheiphan/spokedown/blob/main/packages/core/src/starterPronunciations.ts)."
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "node build.mjs && node test/e2e/run.mjs",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "kokoro-js": "1.2.1",
    "mathjax-full": "^3.2.2",
    "speech-rule-engine": "^4.1.5"
  },
  "devDependencies": {
    "@spokedown/core": "workspace:*",
    "@spokedown/engine": "workspace:*",
    "@types/hast": "^3.0.4",
    "@types/jsdom": "^21.1.7",
    "@types/mdast": "^4.0.4",
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "0.28.2",
    "jsdom": "^26.1.0",
    "katex": "0.19.1",
    "mermaid": "12.3.0",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-stringify": "10.0.1",
    "remark-rehype": "11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  },
  "author": "Sheiphan Shaijan Joseph",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sheiphan/spokedown.git"
  },
  "homepage": "https://github.com/Sheiphan/spokedown#readme",
  "bugs": {
    "url": "https://github.com/Sheiphan/spokedown/issues"
  },
  "preview": true,
  "icon": "assets/icon.png",
  "keywords": [
    "markdown",
    "text to speech",
    "tts",
    "read aloud",
    "kokoro",
    "offline",
    "accessibility",
    "math",
    "karaoke",
    "highlight",
    "claude",
    "agents",
    "speech"
  ],
  "galleryBanner": {
    "color": "#1d2230",
    "theme": "dark"
  }
}
